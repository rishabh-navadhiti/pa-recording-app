{
  "name": "ai-medical-scribe",
  "productName": "Ai medical scribe",
  "version": "0.1.0",
  "description": "System tray app for medical scribes to capture and transcribe Teams call audio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:unit": "node --test --test-force-exit tests/unit/**/*.test.js tests/unit/*.test.js",
    "test:integration": "node --test --test-force-exit tests/integration/**/*.test.js tests/integration/*.test.js",
    "test": "node --test --test-force-exit tests/unit/**/*.test.js tests/unit/*.test.js tests/integration/**/*.test.js tests/integration/*.test.js"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^34.0.0",
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0"
  }
}
